---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import { asset } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await getCollection('gallery');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<StarlightPage
  frontmatter={{
    title: entry.data.title,
    description: entry.data.description ?? `${entry.data.artist ?? '观园创作者'} 的作品`,
  }}
>
  <div style="margin: 1.5rem 0 2rem;">
    <img
      src={asset(entry.data.image)}
      alt={entry.data.title}
      style="width: 100%; height: auto; border-radius: 0.75rem;"
    />
  </div>

  <p style="color: var(--sl-color-gray-3); font-size: var(--sl-text-sm);">
    {entry.data.artist ? `作者：${entry.data.artist}` : ''}
    {
      entry.data.date
        ? `　·　${entry.data.date.toISOString().slice(0, 10)}`
        : ''
    }
    {entry.data.tags.length > 0 ? `　·　${entry.data.tags.join(' / ')}` : ''}
  </p>

  {
    entry.data.gallery.length > 0 && (
      <div class="gallery-grid">
        {entry.data.gallery.map((src) => (
          <img src={asset(src)} alt={`${entry.data.title} 附图`} loading="lazy" />
        ))}
      </div>
    )
  }

  <Content />
</StarlightPage>
